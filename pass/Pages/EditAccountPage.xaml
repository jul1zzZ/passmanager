<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="pass.Pages.EditAccountPage"
              Title="Редактировать запись">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Entry x:Name="ServiceNameEntry" Placeholder="Название сервиса"/>
            <Entry x:Name="UsernameEntry" Placeholder="Логин"/>
            <Entry x:Name="PasswordEntry" Placeholder="Пароль" IsPassword="True"/>
            <Editor x:Name="NotesEditor" Placeholder="Заметки" HeightRequest="100"/>

            <Button Text="Сохранить изменения" Clicked="OnSaveClicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>