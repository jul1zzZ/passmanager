<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="pass.Pages.AddAccountPage"
             Title="Добавить аккаунт"
             BackgroundColor="#FAFAFA">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Заголовок -->
            <Label Text="Добавить аккаунт"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="Black"
                   HorizontalOptions="Center"/>

            <!-- Сервис -->
            <Entry x:Name="ServiceNameEntry"
                   Placeholder="Название сервиса"
                   BackgroundColor="White"
                   TextColor="Black"
                   PlaceholderColor="#888"
                   HeightRequest="45"/>

            <!-- Логин -->
            <Entry x:Name="UsernameEntry"
                   Placeholder="Логин"
                   BackgroundColor="White"
                   TextColor="Black"
                   PlaceholderColor="#888"
                   HeightRequest="45"/>

            <!-- Категория -->
            <Label Text="Категория:" 
                   FontAttributes="Bold" 
                   TextColor="Black"/>
            <Picker x:Name="CategoryPicker"
                    Title="Выберите категорию"
                    BackgroundColor="White"
                    TextColor="Black"
                    HeightRequest="45"/>

            <!-- Пароль -->
            <Label Text="Пароль:" FontAttributes="Bold" TextColor="Black"/>
            <HorizontalStackLayout Spacing="10">
                <Entry x:Name="PasswordEntry"
                       Placeholder="Пароль"
                       IsPassword="True"
                       BackgroundColor="White"
                       TextColor="Black"
                       PlaceholderColor="#888"
                       HeightRequest="45"
                       HorizontalOptions="FillAndExpand"/>
                <Button Text="Сгенерировать"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        Clicked="OnGeneratePasswordClicked"/>
            </HorizontalStackLayout>

            <VerticalStackLayout>
                <Label Text="Длина пароля:" FontAttributes="Bold" TextColor="Black"/>

                <Slider x:Name="LengthSlider"
            Minimum="8"
            Maximum="32"
            Value="16"
            ValueChanged="OnSliderValueChanged"
            MinimumTrackColor="#1976D2"
            MaximumTrackColor="#E0E0E0"
            ThumbColor="#1976D2"/>

                <Label x:Name="LengthLabel" 
           Text="16 символов"
           HorizontalOptions="Center" TextColor="Black"/>
            </VerticalStackLayout>


            <!-- Иконка -->
            <Label Text="Выберите иконку:" 
                   FontAttributes="Bold" 
                   TextColor="Black"/>
            <CollectionView x:Name="IconCollection"
                            ItemsSource="{Binding IconList}"
                            SelectionMode="Single"
                            SelectionChanged="OnIconSelected"
                            ItemsLayout="Grid, 4">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="5"
                               Margin="5"
                               CornerRadius="8"
                               HasShadow="False"
                               BackgroundColor="White"
                               BorderColor="#DDD">
                            <Image Source="{Binding}" 
                                   WidthRequest="40" 
                                   HeightRequest="40"/>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Заметки -->
            <Editor x:Name="NotesEditor"
                    Placeholder="Заметки"
                    HeightRequest="100"
                    BackgroundColor="White"
                    TextColor="Black"
                    PlaceholderColor="#888"/>

            <!-- Кнопка сохранить -->
            <Button Text="Сохранить"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    HeightRequest="50"
                    CornerRadius="10"
                    Clicked="OnSaveClicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
