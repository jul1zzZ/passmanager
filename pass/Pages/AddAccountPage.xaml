<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="pass.Pages.AddAccountPage"
             Title="Добавить аккаунт">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Entry x:Name="ServiceNameEntry" Placeholder="Название сервиса"/>
            <Entry x:Name="UsernameEntry" Placeholder="Логин"/>

            <!-- Выбор категории -->
            <Picker x:Name="CategoryPicker" Title="Выберите категорию"/>

            <!-- Поле пароля + кнопка "Сгенерировать" -->
            <HorizontalStackLayout Spacing="10">
                <Entry x:Name="PasswordEntry"
               Placeholder="Пароль"
               IsPassword="True"
               HorizontalOptions="FillAndExpand"/>
                <Button Text="Сгенерировать"
                Clicked="OnGeneratePasswordClicked"/>
            </HorizontalStackLayout>

            <!-- Ползунок длины пароля -->
            <VerticalStackLayout>
                <Label Text="Длина пароля:" FontAttributes="Bold"/>
                <Slider x:Name="LengthSlider"
                Minimum="8"
                Maximum="32"
                Value="16"
                ValueChanged="OnSliderValueChanged"/>
                <Label x:Name="LengthLabel" 
               Text="16 символов"
               HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <Editor x:Name="NotesEditor"
            Placeholder="Заметки"
            HeightRequest="100"/>

            <Button Text="Сохранить"
            Clicked="OnSaveClicked"/>
        </VerticalStackLayout>

    </ScrollView>
</ContentPage>
