<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="pass.Pages.LoginPage"
             Title="Авторизация"
             BackgroundColor="White">

    <ContentPage.Resources>
        <!-- Стиль кружков -->
        <Style x:Key="PinCircleStyle" TargetType="Frame">
            <Setter Property="WidthRequest" Value="20"/>
            <Setter Property="HeightRequest" Value="20"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderColor" Value="Black"/>
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="HasShadow" Value="False"/>
        </Style>
    </ContentPage.Resources>

    <VerticalStackLayout Padding="40" Spacing="30" VerticalOptions="Center" HorizontalOptions="Center">

        <!-- Заголовок -->
        <Label x:Name="TitleLabel"
               Text="Введите PIN"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="#333"/>

        <!-- Кружки -->
        <HorizontalStackLayout x:Name="PinDisplay" Spacing="15" HorizontalOptions="Center">
            <Frame Style="{StaticResource PinCircleStyle}" x:Name="Pin1"/>
            <Frame Style="{StaticResource PinCircleStyle}" x:Name="Pin2"/>
            <Frame Style="{StaticResource PinCircleStyle}" x:Name="Pin3"/>
            <Frame Style="{StaticResource PinCircleStyle}" x:Name="Pin4"/>
        </HorizontalStackLayout>

        <!-- Цифровая клавиатура -->
        <Grid RowSpacing="10" ColumnSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>

            <!-- Цифры -->
            <Button Text="1" Grid.Row="0" Grid.Column="0" Clicked="OnDigitClicked"/>
            <Button Text="2" Grid.Row="0" Grid.Column="1" Clicked="OnDigitClicked"/>
            <Button Text="3" Grid.Row="0" Grid.Column="2" Clicked="OnDigitClicked"/>

            <Button Text="4" Grid.Row="1" Grid.Column="0" Clicked="OnDigitClicked"/>
            <Button Text="5" Grid.Row="1" Grid.Column="1" Clicked="OnDigitClicked"/>
            <Button Text="6" Grid.Row="1" Grid.Column="2" Clicked="OnDigitClicked"/>

            <Button Text="7" Grid.Row="2" Grid.Column="0" Clicked="OnDigitClicked"/>
            <Button Text="8" Grid.Row="2" Grid.Column="1" Clicked="OnDigitClicked"/>
            <Button Text="9" Grid.Row="2" Grid.Column="2" Clicked="OnDigitClicked"/>

            <Button Text="⌫" Grid.Row="3" Grid.Column="0" Clicked="OnBackspaceClicked"/>
            <Button Text="0" Grid.Row="3" Grid.Column="1" Clicked="OnDigitClicked"/>
            <Button Text="✔" Grid.Row="3" Grid.Column="2" Clicked="OnSubmitClicked"/>
        </Grid>
    </VerticalStackLayout>
</ContentPage>
